# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
# Server-only secret key (sb_secret_...). Required for review and study modes (learning writes go through
# server-only DB functions); also writes the shared word cache
SUPABASE_SECRET_KEY=
# Only needed to push migrations with `supabase db push --db-url`
SUPABASE_DB_PASSWORD=

# LLM (server-only)
DEEPSEEK_API_KEY=
AI_MODEL=

# Self-hosted speech service (services/speech): pronunciation scoring + TTS. Server-only
SPEECH_SERVICE_URL=
SPEECH_SERVICE_TOKEN=

# Optional, server-only: Groq Whisper for free speaking. Without it, use browser STT or manual text.
GROQ_API_KEY=

# Optional, only for pnpm seed:courses: UUID of the existing content profile.
SEED_CONTENT_OWNER_ID=
